# Notion-backed blog (components read these in lib/notion.ts).
#
# 1. Create an internal integration: https://www.notion.so/my-integrations
#    Capabilities: "Read content" is enough. Copy the Internal Integration Secret.
# 2. Open the "Blog" database in Notion → ••• → Connections → add that integration.
# 3. Put both values below in .env.local, and in the Vercel project's
#    Environment Variables for the deployed site.
#
# Without these the blog page still builds and shows its empty state.

NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_BLOG_DATABASE_ID=d1d409de193d48e3ab9c2553116e9230
